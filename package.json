{
  "name": "limit-lens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0",
    "hyparquet": "^1.31.4",
    "hyparquet-compressors": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/run-v5-regression.mjs",
    "test:v5": "node scripts/run-v5-regression.mjs",
    "test:ui": "node --test test/frontend/*.test.mjs",
    "test:dragon": "node --test legacy-tests/dragon-risk.mjs legacy-tests/dragon-flexibility.mjs test/dragon/*.test.mjs",
    "dev": "node dev.mjs",
    "start": "node server.mjs",
    "verify:paper": "node scripts/verify-paper.mjs",
    "verify:execution-cost": "node scripts/verify-execution-cost.mjs",
    "verify:execution-evidence": "node scripts/verify-execution-evidence.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:evidence-simulation": "node scripts/evidence-simulation.mjs",
    "format": "prettier --write frontend backend shared scripts test db build.mjs dev.mjs server.mjs",
    "check": "prettier --check frontend backend shared scripts test db build.mjs dev.mjs server.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.44.7",
    "esbuild": "^0.25.12",
    "prettier": "^3.6.2"
  },
  "prettier": {
    "endOfLine": "auto"
  }
}
