AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AUTH_USER=owner
AUTH_PASSWORD=
PUBLIC_ORIGIN=http://localhost:3000
TRADING_ENABLED=true
TRADING_POLL_SECONDS=10
# 本地元数据更新执行器：仅在数据管理页面手动提交后抓取
DATA_WORKER_ENABLED=true
# 申万分类默认采用理杏仁批量 API（2 次请求，需官方核验时另取 1 份文件）
SW_METADATA_SOURCE=lixinger
LIXINGER_TOKEN=
# 如需显式使用乐咕逐行业网页抓取，可设 SW_METADATA_SOURCE=legulegu
LOCAL_RESEARCH_DB_PATH=.sites-runtime/research-history.sqlite
# 每日收盘 parquet 数据目录（quan_quant 维护）：daily.parquet + adj_factor.parquet，
# 用于买点 MA5 校验。留空则 MA5 不可用，首阴买点不触发（其余功能不受影响）。
QUAN_DATA_DIR=D:/Sanchez/AI/TraeProjects/quan_quant/data
# 运维告警：留空即未启用（页面会如实显示“主动告警未启用”）
ALERTS_ENABLED=true
TRADE_NOTIFICATIONS_ENABLED=true
ALERT_INSTANCE_ALIAS=windows-paper
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
# 外部失联监测（Healthchecks.io 等）Ping URL；留空则不做外部离线探测
WATCHDOG_PROGRESS_URL=
WATCHDOG_PIPELINE_URL=
